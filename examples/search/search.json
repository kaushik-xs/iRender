{
  "version": 1,
  "theme": { "tokens": { "color": { "primary": "#7c3aed", "primary-hover": "#6d28d9" } } },
  "state": { "category": "all", "query": "", "results": null, "loading": false, "selected": null },
  "root": {
    "type": "stack",
    "props": { "gap": "$space.md" },
    "attrs": { "id": "search" },
    "style": {
      "max-width": 880, "margin": "0 auto", "padding": "$space.lg",
      "font-family": "$font.body", "color": "$color.text", "background": "$color.surface"
    },
    "on": {
      "mount": [
        { "action": "set_state", "key": "loading", "value": true },
        { "action": "submit", "method": "GET", "endpoint": "api/{{ category }}.json", "body": { "q": "{{ query }}" }, "into": "results" },
        { "action": "set_state", "key": "loading", "value": false }
      ]
    },
    "children": [
      { "type": "text", "props": { "tag": "h1", "value": "Find gear" }, "style": { "margin": 0 } },

      {
        "type": "element",
        "props": { "tag": "form" },
        "attrs": { "role": "search" },
        "style": { "display": "flex", "gap": "$space.sm" },
        "on": {
          "submit": [
            { "action": "set_state", "key": "loading", "value": true },
            { "action": "submit", "method": "GET", "endpoint": "api/{{ category }}.json", "body": { "q": "{{ query }}" }, "into": "results" },
            { "action": "set_state", "key": "loading", "value": false }
          ]
        },
        "children": [
          {
            "type": "input",
            "props": { "bind": "query", "type": "search", "placeholder": "Search {{ category == 'all' ? 'everything' : category }}…" },
            "attrs": { "aria-label": "Search" },
            "style": { "flex": 1 }
          },
          { "type": "button", "props": { "label": "{{ loading ? 'Searching…' : 'Search' }}", "type": "submit", "disabled": "{{ loading }}" } }
        ]
      },

      {
        "type": "list",
        "props": { "items": ["all", "kitchen", "outdoor", "garden"], "as": "cat" },
        "attrs": { "role": "tablist" },
        "style": { "display": "flex", "gap": "$space.xs" },
        "children": [
          {
            "type": "button",
            "props": { "label": "{{ cat }}", "variant": "ghost" },
            "attrs": { "role": "tab", "aria-selected": "{{ category == cat }}" },
            "style": {
              "text-transform": "capitalize",
              "&[aria-selected=true]": { "background": "$color.primary", "color": "#fff" }
            },
            "on": {
              "click": [
                { "action": "set_state", "key": "category", "value": "{{ cat }}" },
                { "action": "set_state", "key": "selected", "value": null },
                { "action": "set_state", "key": "loading", "value": true },
                { "action": "submit", "method": "GET", "endpoint": "api/{{ category }}.json", "body": { "q": "{{ query }}" }, "into": "results" },
                { "action": "set_state", "key": "loading", "value": false }
              ]
            }
          }
        ]
      },

      {
        "type": "text",
        "props": { "tag": "p", "value": "{{ loading ? 'Loading…' : results ? results.total + ' results' + (query ? ' for “' + query + '”' : '') : '' }}" },
        "attrs": { "aria-live": "polite" },
        "style": { "margin": 0, "color": "$color.muted", "font-size": "$font.size.sm", "min-height": "1.4em" }
      },

      {
        "type": "if",
        "props": { "when": "{{ results && results.items.length == 0 }}" },
        "children": [
          {
            "type": "stack",
            "props": { "align": "center", "gap": "$space.xs" },
            "style": { "padding": "$space.xl", "border": "1px dashed $color.border", "border-radius": "$radius.lg" },
            "children": [
              { "type": "text", "props": { "value": "Nothing in {{ category }} yet" }, "style": { "font-weight": 600 } },
              { "type": "text", "props": { "value": "Try another category." }, "style": { "color": "$color.muted" } }
            ]
          }
        ]
      },

      {
        "type": "stack",
        "props": { "direction": "row", "gap": "$space.md", "align": "flex-start" },
        "children": [
          {
            "type": "list",
            "props": { "items": "{{ results.items }}", "as": "p", "key": "{{ p.id }}" },
            "style": { "flex": 1, "display": "grid", "gap": "$space.sm", "grid-template-columns": "repeat(auto-fill, minmax(220px, 1fr))" },
            "children": [
              {
                "type": "stack",
                "props": { "gap": "$space.xs" },
                "class": ["card"],
                "attrs": { "aria-current": "{{ selected.id == p.id }}" },
                "style": {
                  "padding": "$space.md", "border": "1px solid $color.border", "border-radius": "$radius.lg",
                  "&[aria-current=true]": { "border-color": "$color.primary", "box-shadow": "0 0 0 1px $color.primary" }
                },
                "on": { "mount": { "action": "call", "name": "impression", "args": { "id": "{{ p.id }}", "position": "{{ index }}" } } },
                "children": [
                  {
                    "type": "stack",
                    "props": { "direction": "row", "justify": "space-between", "gap": "$space.xs" },
                    "children": [
                      { "type": "text", "props": { "value": "{{ p.name }}" }, "style": { "font-weight": 600 } },
                      { "type": "text", "props": { "value": "₹{{ p.price }}" } }
                    ]
                  },
                  {
                    "type": "list",
                    "props": { "items": "{{ p.tags }}", "as": "tag" },
                    "style": { "display": "flex", "gap": 4, "flex-wrap": "wrap" },
                    "children": [
                      {
                        "type": "text",
                        "props": { "value": "{{ tag }}" },
                        "style": { "font-size": 12, "padding": "1px 8px", "border-radius": 999, "background": "#f3f4f6", "color": "$color.muted" }
                      }
                    ]
                  },
                  {
                    "type": "if",
                    "props": { "when": "{{ p.stock == 0 }}" },
                    "children": [{ "type": "text", "props": { "value": "Out of stock" }, "style": { "color": "#b91c1c", "font-size": "$font.size.sm" } }]
                  },
                  {
                    "type": "if",
                    "props": { "when": "{{ p.stock > 0 && p.stock < 5 }}" },
                    "children": [{ "type": "text", "props": { "value": "Only {{ p.stock }} left" }, "style": { "color": "#b45309", "font-size": "$font.size.sm" } }]
                  },
                  {
                    "type": "button",
                    "props": { "label": "Details", "variant": "secondary" },
                    "on": { "click": { "action": "set_state", "key": "selected", "value": "{{ p }}" } }
                  }
                ]
              }
            ]
          },

          {
            "type": "if",
            "props": { "when": "{{ selected }}" },
            "children": [
              {
                "type": "stack",
                "props": { "tag": "aside", "gap": "$space.sm" },
                "attrs": { "aria-label": "Product details" },
                "style": {
                  "width": 260, "padding": "$space.md", "border-radius": "$radius.lg", "background": "#faf5ff",
                  "position": "sticky", "top": "$space.md"
                },
                "children": [
                  { "type": "text", "props": { "tag": "h2", "value": "{{ selected.name }}" }, "style": { "margin": 0, "font-size": 18 } },
                  { "type": "text", "props": { "tag": "p", "value": "{{ selected.description }}" }, "style": { "margin": 0, "color": "$color.muted" } },
                  { "type": "text", "props": { "value": "★ {{ selected.rating }} · {{ selected.reviews }} reviews" }, "style": { "font-size": "$font.size.sm" } },
                  {
                    "type": "button",
                    "props": { "label": "{{ selected.stock == 0 ? 'Notify me' : 'Add to cart · ₹' + selected.price }}" },
                    "on": { "click": { "action": "call", "name": "cart", "args": { "id": "{{ selected.id }}", "notify": "{{ selected.stock == 0 }}" } } }
                  },
                  {
                    "type": "button",
                    "props": { "label": "Close", "variant": "ghost" },
                    "on": { "click": { "action": "set_state", "key": "selected", "value": null } }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
